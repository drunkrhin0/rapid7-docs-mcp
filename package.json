{
  "name": "rapid7-docs-mcp-server",
  "version": "2.0.0",
  "description": "Rapid7 documentation crawlers — powering the FastMCP server",
  "type": "module",
  "scripts": {
    "crawl": "tsx crawl.ts",
    "crawl:section": "tsx crawl.ts --section",
    "crawl:extensions": "tsx crawl-extensions.ts",
    "crawl:site": "tsx crawl-site.ts",
    "crawl:external": "tsx crawl-external.ts",
    "test": "vitest run",
    "test:py": "pytest server/tests/",
    "test:all": "npm test && npm run test:py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --audit-level=high",
    "version:sync": "node scripts/version-sync.mjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0",
    "js-yaml": "^4.1.1",
    "tsx": "^4.0.0",
    "turndown": "^7.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.4",
    "commit-and-tag-version": "^12.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.6"
  }
}
